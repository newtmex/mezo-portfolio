# Required — gauge-emissions / CL manager wallet (public address only)
MANAGER_ADDRESS=0xBAA1faa243f5EBd72A629703349CB2d76dbB9E05
NEXT_PUBLIC_MANAGER_ADDRESS=0xBAA1faa243f5EBd72A629703349CB2d76dbB9E05

# Mezo mainnet RPCs (Boar)
MEZO_RPC_HTTP=https://mezo-mainnet.boar.network
MEZO_RPC_WSS=wss://mezo-mainnet.boar.network
NEXT_PUBLIC_MEZO_RPC_HTTP=https://mezo-mainnet.boar.network
