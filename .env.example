# Base Aerodrome pool RPCs (optional; defaults to PublicNode + LlamaRPC + Base public RPC)
BASE_RPC_HTTP=https://base-rpc.publicnode.com
# Comma-separated fallbacks; a dedicated provider URL can be used as the primary above.
BASE_RPC_HTTP_FALLBACKS=https://base.llamarpc.com,https://mainnet.base.org

# Optional
NEXT_PUBLIC_MEZO_EXPLORER=https://explorer.mezo.org
MEZO_API_BASE_URL=https://api.mezo.org
